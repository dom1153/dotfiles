% recipes

# Print and [f]ollow a file
tail -f 

% recipes, sha256

# Validate SHA-256 against directory iso(s)
sha256sum -c <checksum_file>
$ checksum_file: find . -type f

# Calculate *.iso checksum
sha256sum <iso_file>
$ iso_file: find . -type f -name '*.iso'

# Validate checksum string
echo "<sha256sum_string> <iso_file>" | sha256sum -c
$ iso_file: find . -type f -name '*.iso'

% recipes, chezmoi

# Pull changes from the source repo and apply any changes
chezmoi update

# Check untracked files in current director or specified paths
chezmoi unmanaged .

# Remove target from the source state AND destination directory
chezmoi destroy 

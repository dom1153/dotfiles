; vanilla -> dust...

# rsync folder (ssh)
rsync -avz --progress /path/to/local/folder/ user@remote:/path/to/destination/

# rsync folder (dry run ssh)
rsync -avzn --delete /local/folder/ user@remote:/remote/folder/

# disk usage fast
df -h

% dump

# connect to orb machine
orb

# ripgrep everythiing
rg SEARCH --no-ignore

# list ghostty fonts
ghostty +list-fonts

# launch ghostty with font (linux)
ghostty --font-family='Ubuntu Sans Mono' &

# show all ghostty default values
ghostty +show-config --default --docs

# check for a given distribution
grep -q "Arch Linux" /etc/os-release

# get full git repository from a depth 1
git fetch --unshallow

# expand a qemu disk
sudo qemu-img resize /var/lib/libvirt/images/proxmox-9.qcow2 +32G

# run a podman debian shell
podman run -it --rm debian bash

# run a docker debian shell
docker run -it --rm debian bash

# search deb files
dpkg -l | grep

[fetch]
	prune = true
[pull]
	rebase = true

# delta themes (catppuccin-*); not git's pager, lazygit picks one with --features
# (mocha / latte: ~/.config/lazygit/theme.yml)
[include]
	path = catppuccin.gitconfig
[merge]
	conflictStyle = zdiff3
# optional machine config, loaded last so it overrides anything above
[include]
	path = local.gitconfig

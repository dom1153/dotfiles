#? docs: https://ghostty.org/docs/config/reference

### appearance
font-size=14
font-feature=-calt, -liga, -dlig # disable font ligatures
background-opacity=0.95

### behavior
# disable quit prompt, annoying when trying to shutdown pc
confirm-close-surface="false"

# don't leave instances in dock (macos)
quit-after-last-window-closed="true"

# auto-inject term-info, does not work with orbstack (custom ssh config)
shell-integration-features=ssh-terminfo,ssh-env

### keybinds
keybind=super+shift+equal=increase_font_size:1 # macos
keybind=ctrl+shift+plus=increase_font_size:1   # linux

# optional machine config, loaded after this file so it overrides anything above
# (mocha / latte packages set the theme)
config-file = ?config.local
